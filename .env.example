# Copy to .env and fill in. .env is gitignored — never commit it.

POSTGRES_USER=hsb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hiring_signal

# Encrypts n8n credentials at rest. Generate once:
#   openssl rand -hex 32
# If you lose this, every credential stored in n8n becomes unreadable.
N8N_ENCRYPTION_KEY=

# Pin after the first start: read the version in the n8n UI footer,
# then set it here so the setup is reproducible.
N8N_VERSION=latest

# Phase C. Not needed for A1.
ANTHROPIC_API_KEY=