        "operation": "executeQuery",
        "query": "insert into companies (snapshot_id, company_key, company_name, role_count,\n                       first_posting_at, latest_posting_at, cities)\nselect snapshot_id,\n       company_key,\n       (array_agg(company_name order by posted_at))[1],\n       count(*),\n       min(posted_at),\n       max(posted_at),\n       array_agg(distinct location) filter (where location <> '')\nfrom jobs\nwhere snapshot_id = {{ $('Create snapshot').first().json.id }}\n  and is_target_role\n  and company_key <> ''\ngroup by snapshot_id, company_key;\n\nupdate snapshots\nset job_count  = (select count(*) from jobs where snapshot_id = {{ $('Create snapshot').first().json.id }}),\n    page_count = {{ $('HTTP Request').all().length }}\nwhere id = {{ $('Create snapshot').first().json.id }};",
