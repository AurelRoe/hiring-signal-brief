    {
      "parameters": {
        "jsCode": "// Role definition, single source of truth: CLAUDE.md.\n// Must match scripts/brief.py later. Same word boundaries as the spike.\nconst ROLES = /\\bsales\\b|\\bvertrieb|\\baccount executive\\b|\\baccount manager|\\bsdr\\b|\\bbdr\\b|\\bbusiness development|\\bkundenberater|\\baußendienst|\\binside sales\\b|\\bpre-?sales\\b|\\bpartner manager/i;\nconst MARKETING = /\\bmarketing/i;\nconst MARKETING_EXCLUDE = /engineer|developer|linguist/i;\n\nfunction isTargetRole(title) {\n  if (ROLES.test(title)) return true;\n  return MARKETING.test(title) && !MARKETING_EXCLUDE.test(title);\n}\n\n// Same normalisation as the spike: \"Acme GmbH\" and \"Acme Group\" -> \"acme\"\nconst LEGAL = /\\b(gmbh|mbh|ag|se|kg|ohg|ug|e\\.?\\s?v\\.?|co\\.?\\s?kg|holding|group|deutschland|germany|inc\\.?|ltd\\.?|llc|b\\.?v\\.?)\\b/gi;\n\nfunction companyKey(name) {\n  return (name || '')\n    .replace(LEGAL, ' ')\n    .replace(/[^\\p{L}\\p{N}\\s]/gu, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .toLowerCase();\n}\n\nconst snapshotId = $('Create snapshot').first().json.id;\n\nreturn $input.all().map(item => {\n  const j = item.json;\n  return { json: {\n    snapshot_id: snapshotId,\n    slug: j.slug,\n    company_name: (j.company_name || '').trim(),\n    company_key: companyKey(j.company_name),\n    title: j.title || '',\n    location: j.location || null,\n    remote: j.remote,\n    url: j.url,\n    description: j.description,\n    posted_at: j.created_at ? new Date(j.created_at * 1000).toISOString() : null,\n    is_target_role: isTargetRole(j.title || ''),\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
